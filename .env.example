# ── NEXUSOPS ENVIRONMENT TEMPLATE ──────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env to git.

# Node environment: development | test | production
NODE_ENV=development

# Backend
PORT=4000
# Comma-separated origins allowed by CORS (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://nexusops:CHANGE_ME_DB_PASSWORD@localhost:5432/nexusops?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_long_random_string
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Encryption key for sensitive fields at rest (32-byte hex)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_byte_hex

# AI (Ollama — local, free, optional. App works without it.)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_ENABLED=true

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Frontend
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
